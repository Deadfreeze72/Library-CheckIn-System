# Copy this file to .env and fill in real values. Never commit the real .env file.

# Required. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# 0 for normal use, 1 for debug mode on your own computer only
FLASK_DEBUG=0

# Optional locally. If unset, the app uses a local SQLite file.
# In production, set this to your Neon (PostgreSQL) connection string.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Optional: turns on "Forgot your password?" emails (sent through Brevo).
# BREVO_API_KEY=your-brevo-api-key
# MAIL_FROM=the-sender-address-you-verified-in-brevo@example.com
# MAIL_FROM_NAME=St. John Bosco College Library
