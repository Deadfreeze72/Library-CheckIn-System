# Copy this file to .env and fill in real values.
# Generate SECRET_KEY with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string
FLASK_DEBUG=0

# Optional locally -- if unset, the app falls back to a local SQLite file.
# Set this to your Neon (or other Postgres) connection string once you have one.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require